{
  "name": "last-things",
  "private": true,
  "version": "1.0.0",
  "description": "Last Things — an interactive study of Christian eschatology",
  "type": "module",
  "scripts": {
    "bible": "node scripts/build-bible.mjs",
    "validate": "vite-node scripts/validate-content.ts",
    "dev": "vite",
    "build": "npm run bible && npm run validate && tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "predev": "npm run bible",
    "pretest": "npm run bible"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@fontsource/noto-serif-tamil": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@xyflow/react": "^12.12.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "framer-motion": "^14.2.0",
    "fuse.js": "^7.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@bible-help/get-bible-verses": "^1.0.12",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "d3-geo": "^3.1.1",
    "jsdom": "^29.1.1",
    "kjv": "^1.0.0",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4",
    "world-atlas": "^2.0.2",
    "world-english-bible": "^1.0.1"
  }
